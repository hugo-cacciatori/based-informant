    <!-- Privacy (05-security.md section 6) -->
    <string name="privacy_section">Privacy</string>
    <string name="privacy_note">To write a digest, the app sends your keywords, your interest tags, a short memory of past digests and your persona choice to rfab.ai and the AI providers it uses. Don’t put sensitive personal details in them. To check links, the app opens each source page. Nothing else leaves this device: no analytics, no crash reports, no server of ours.</string>
