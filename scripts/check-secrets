#!/bin/sh
# check-secrets: look for API keys, tokens, private keys and keystore files before they leave
# this machine. The git hooks in .githooks/ run it before every commit and push, and the release
# gate runs it on the repo and on every built artifact.
#
#   scripts/check-secrets              tracked and untracked (not ignored) files in the working tree
#   scripts/check-secrets --staged     the staged version of every staged file (pre-commit hook)
#   scripts/check-secrets --pre-push   every commit about to be pushed (reads git's pre-push input)
#   scripts/check-secrets --apk FILE   every file inside an APK
#   scripts/check-secrets --msi FILE   every file inside an MSI (Windows only, extracted with msiexec)
#   scripts/check-secrets --dir DIR    every file under DIR
#
# Exit status: 0 nothing found, 1 something found, 2 usage or tool error.
# Findings name the file, the line and the kind of secret, never the secret itself.

set -u

die() { echo "check-secrets: $*" >&2; exit 2; }

usage() { sed -n '2,14s/^# \{0,1\}//p' "$0"; }

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || die "cannot find the scripts directory"
scanner="$here/check-secrets.awk"
[ -f "$scanner" ] || die "missing $scanner"

tmp=$(mktemp -d) || die "mktemp failed"
trap '[ -n "$tmp" ] && rm -rf "$tmp"' EXIT
trap 'exit 2' INT TERM
report="$tmp/report"
: > "$report"
prefix=""

# File names that must never be committed, whatever they contain.
check_name() {
    case ${1##*/} in
        .env.example) ;;
        .env|.env.*|*.jks|*.keystore|*.p12|*.pfx|keystore.properties)
            echo "$prefix$1: secret file that must never be committed" >> "$report" ;;
    esac
}

# Scans stdin as the content of file $1. NUL bytes are removed so UTF-16 text is scanned too.
scan_content() {
    tr -d '\000' | awk -v path="$prefix$1" -f "$scanner" >> "$report"
}

scan_tree() {
    top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git work tree (use --dir)"
    cd "$top" || die "cannot enter $top"
    git -c core.quotepath=off ls-files --cached --others --exclude-standard > "$tmp/files" \
        || die "git ls-files failed"
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        check_name "$f"
        scan_content "$f" < "$f"
    done < "$tmp/files"
}

scan_staged() {
    git -c core.quotepath=off diff --cached --name-only --diff-filter=ACMR > "$tmp/files" \
        || die "git diff --cached failed"
    while IFS= read -r f; do
        check_name "$f"
        git cat-file blob ":$f" 2>/dev/null | scan_content "$f"
    done < "$tmp/files"
}

# Git writes one line per pushed ref: <local ref> <local sha> <remote ref> <remote sha>.
# Every commit not yet on the remote is scanned, so a secret added and then removed in a later
# commit is still caught (it would be in the pushed history).
scan_push() {
    while read -r local_ref local_sha remote_ref remote_sha; do
        case $local_sha in *[!0]*) ;; *) continue ;; esac   # deleting a branch: nothing to scan
        range="$local_sha --not --remotes"
        case $remote_sha in
            *[!0]*) git cat-file -e "$remote_sha^{commit}" 2>/dev/null && range="$remote_sha..$local_sha" ;;
        esac
        # $range is split on purpose: it can be "A..B" or "B --not --remotes".
        # shellcheck disable=SC2086
        git -c core.quotepath=off log -p --text --no-color --no-ext-diff --no-textconv --unified=0 \
            --format='@@COMMIT %h' $range | tr -d '\000' | awk -v mode=diff -f "$scanner" >> "$report"
        # shellcheck disable=SC2086
        git -c core.quotepath=off log --name-only --diff-filter=ACMR --format= $range > "$tmp/names"
        while IFS= read -r f; do
            [ -n "$f" ] && check_name "$f"
        done < "$tmp/names"
    done
}

scan_dir() {
    [ -d "$1" ] || die "not a directory: $1"
    find "$1" -type f > "$tmp/files"
    while IFS= read -r f; do
        rel=${f#"$1"/}
        check_name "$rel"
        scan_content "$rel" < "$f"
    done < "$tmp/files"
}

scan_apk() {
    [ -f "$1" ] || die "no such file: $1"
    command -v unzip >/dev/null 2>&1 || die "--apk needs unzip"
    mkdir "$tmp/unpacked" || die "mkdir failed"
    unzip -qq -o "$1" -d "$tmp/unpacked"
    [ $? -le 1 ] || die "could not unpack $1"   # 1 = warnings only
    prefix="${1##*/}!/"
    scan_dir "$tmp/unpacked"
}

# Not yet tried on a real MSI: verify with the first Windows build.
scan_msi() {
    [ -f "$1" ] || die "no such file: $1"
    command -v msiexec.exe >/dev/null 2>&1 && command -v cygpath >/dev/null 2>&1 \
        || die "--msi needs Windows (msiexec) and Git Bash (cygpath)"
    mkdir "$tmp/unpacked" || die "mkdir failed"
    # An administrative install only extracts the files; nothing gets installed.
    MSYS_NO_PATHCONV=1 msiexec.exe /a "$(cygpath -w "$1")" /qn TARGETDIR="$(cygpath -w "$tmp/unpacked")" \
        || die "msiexec could not extract $1"
    prefix="${1##*/}!/"
    scan_dir "$tmp/unpacked"
}

case ${1-} in
    "")         what="working tree"; scan_tree ;;
    --staged)   what="staged files"; scan_staged ;;
    --pre-push) what="commits to push"; scan_push ;;
    --apk)      [ $# -eq 2 ] || die "usage: check-secrets --apk FILE"; what="APK"; scan_apk "$2" ;;
    --msi)      [ $# -eq 2 ] || die "usage: check-secrets --msi FILE"; what="MSI"; scan_msi "$2" ;;
    --dir)      [ $# -eq 2 ] || die "usage: check-secrets --dir DIR"; what="directory"; scan_dir "$2" ;;
    -h|--help)  usage; exit 0 ;;
    *)          die "unknown option: $1 (see --help)" ;;
esac

if [ -s "$report" ]; then
    sort -u "$report" | sed 's/^/  /' >&2
    n=$(sort -u "$report" | wc -l | tr -d ' ')
    echo "check-secrets: $n possible secret(s) in the $what. Values are not printed." >&2
    echo "If a real key is involved, rotate it first, then remove it and try again." >&2
    exit 1
fi
echo "check-secrets: no secrets found in the $what." >&2
exit 0
