#!/bin/sh
# Tests for scripts/check-secrets: run scripts/test-check-secrets.
# Builds throwaway git repos in a temp directory and plants fake secrets made at run time, so no
# secret-looking literal lives in this file. Each fake must be caught without being printed, and
# documented placeholders and normal code must pass.

set -u

here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || exit 2
work=$(mktemp -d) || exit 2
trap 'cd / && rm -rf "$work"' EXIT
mkdir "$work/nohooks"
pass=0
fail=0

cs() { sh "$here/check-secrets" "$@"; }

rand() { od -An -N20 -tx1 /dev/urandom | tr -d ' \n'; }
suffix="Q$(rand)"                 # upper, lower and digits, like a real key
fake_rfab="rfab""_$suffix"
zero=0000000000000000000000000000000000000000

# expect NAME STATUS COMMAND...: the command must exit with STATUS and never print the fake key.
expect() {
    name=$1 want=$2
    shift 2
    out=$("$@" 2>&1)
    got=$?
    if [ "$got" -ne "$want" ]; then
        fail=$((fail + 1))
        printf 'FAIL  %s (exit %s, expected %s)\n' "$name" "$got" "$want"
        printf '%s\n' "$out" | sed 's/^/      /'
    elif case $out in *"$suffix"*) true ;; *) false ;; esac; then
        fail=$((fail + 1))
        printf 'FAIL  %s (the secret was printed)\n' "$name"
    else
        pass=$((pass + 1))
        printf 'ok    %s\n' "$name"
    fi
}

new_repo() {
    mkdir "$work/$1" && cd "$work/$1" || exit 2
    git init -q -b main
    git config user.email test@example.com
    git config user.name test
    git config core.autocrlf false
    git config core.hooksPath "$work/nohooks"
    git config commit.gpgsign false
}

commit() { git add -A && git commit -qm "$1"; }

utf16() { awk '{ for (i = 1; i <= length($0); i++) printf "%s%c", substr($0, i, 1), 0; printf "\n%c", 0 }'; }

prepush() { printf 'refs/heads/main %s refs/heads/main %s\n' "$1" "$2" | cs --pre-push; }

# --- placeholders and normal code pass ---
new_repo clean
printf '%s\n' 'RFAB_API_KEY=rfab_your_key_here' > .env.example
printf '%s\n' 'Send the header X-API-Key: rfab_... with every call.' > notes.md
printf '%s\n' 'val name = "rfab_api_key_environment_variable"' \
    'request.header("X-API-Key", apiKey)' \
    'storePassword = keystoreProperties["storePassword"] as String' > Code.kt
expect "placeholders and normal code pass (tree)" 0 cs
git add -A
expect "placeholders and normal code pass (staged)" 0 cs --staged
commit clean
expect "clean history passes (pre-push)" 0 prepush "$(git rev-parse HEAD)" "$zero"
expect "deleting a branch passes (pre-push)" 0 prepush "$zero" "$(git rev-parse HEAD)"

# --- rfab key in the tree, the index and the history ---
new_repo tree
printf 'val key = "%s"\n' "$fake_rfab" > Config.kt
expect "rfab key in an untracked file (tree)" 1 cs
git add Config.kt
expect "rfab key in a staged file (staged)" 1 cs --staged

new_repo utf16
printf 'key=%s\n' "$fake_rfab" | utf16 > strings.txt
expect "rfab key in a UTF-16 file (tree)" 1 cs

new_repo history
echo hello > a.txt
commit base
base=$(git rev-parse HEAD)
printf 'token=%s\n' "$fake_rfab" > b.txt
commit "add key"
rm b.txt
commit "remove key"
head=$(git rev-parse HEAD)
expect "key added then removed, new branch (pre-push)" 1 prepush "$head" "$zero"
expect "key added then removed, existing branch (pre-push)" 1 prepush "$head" "$base"
echo more >> a.txt
commit later
expect "only clean commits after the remote (pre-push)" 0 prepush "$(git rev-parse HEAD)" "$head"

# --- APK ---
new_repo apk
mkdir res
printf 'apiKey=%s\n' "$fake_rfab" > res/values.txt
printf 'k=%s\n' "$fake_rfab" | utf16 > resources.arsc
commit apk
git archive --format=zip -o "$work/app.apk" HEAD
expect "rfab key inside an APK (--apk)" 1 cs --apk "$work/app.apk"

new_repo apkclean
echo hello > classes.txt
commit apk
git archive --format=zip -o "$work/clean.apk" HEAD
expect "clean APK passes (--apk)" 0 cs --apk "$work/clean.apk"

# --- other kinds of secrets, each in its own repo ---
kinds=0
kind() {
    kinds=$((kinds + 1))
    new_repo "kind$kinds"
    printf '%s\n' "$3" > "$2"
    expect "$1" 1 cs
}
kind "private key block" key.pem "$(printf '%s%s' '-----BEGIN RSA PRIVATE' ' KEY-----')"
kind "Google OAuth client secret" client.json "$(printf 'secret=%s%s' 'GOCSPX' "-$suffix")"
kind "GitHub token" ci.yml "$(printf 'token: %s%s' 'ghp' "_$suffix")"
kind "X-API-Key with a real value" call.http "$(printf '%s: %s' 'X-API-Key' "$suffix")"
kind "keystore password in code" build.gradle.kts "$(printf '%s = "%s"' 'storePass''word' 'Hunter22x')"
kind "keystore password in properties" gradle.properties "$(printf '%s=%s' 'keyPass''word' 'abc12345')"
kind "keystore file" release.jks "binary"
kind ".env file" .env "RFAB_API_KEY=placeholder"

# --- usage errors ---
expect "unknown option is an error" 2 cs --nope
expect "missing APK is an error" 2 cs --apk "$work/missing.apk"

printf '\n%s passed, %s failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
